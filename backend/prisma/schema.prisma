datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  employees     Employee[]
  compensations Compensation[]
  auditLogs     AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  compensationsCreated Compensation[]
  auditLogsCreated     AuditLog[]

  @@unique([tenantId, email])
}

model Employee {
  id          String   @id @default(uuid())
  tenantId    String
  firstName   String
  lastName    String
  email       String
  department  String
  country     String
  hireDate    DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  compensations Compensation[]
  auditLogs     AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, department])
  @@index([tenantId, country])
}

model Compensation {
  id            String   @id @default(uuid())
  tenantId      String
  employeeId    String
  amount        Decimal  @db.Decimal(10, 2)
  currency      String
  effectiveDate DateTime
  createdAt     DateTime @default(now())
  createdBy     String

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  employee      Employee @relation(fields: [employeeId], references: [id])
  creator       User     @relation(fields: [createdBy], references: [id])

  // Relations for AuditLog
  auditLogsAsPrevious AuditLog[] @relation("PreviousCompensation")
  auditLogsAsNew      AuditLog[] @relation("NewCompensation")

  @@index([tenantId, employeeId, effectiveDate(sort: Desc)])
}

model AuditLog {
  id                     String   @id @default(uuid())
  tenantId               String
  employeeId             String
  actorId                String
  action                 String   // e.g., "SALARY_UPDATE"
  entity                 String   // e.g., "COMPENSATION"
  previousCompensationId String?
  newCompensationId      String
  reason                 String?
  createdAt              DateTime @default(now())

  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  employee             Employee      @relation(fields: [employeeId], references: [id])
  actor                User          @relation(fields: [actorId], references: [id])
  previousCompensation Compensation? @relation("PreviousCompensation", fields: [previousCompensationId], references: [id])
  newCompensation      Compensation  @relation("NewCompensation", fields: [newCompensationId], references: [id])

  @@index([tenantId, employeeId])
}
